<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only, system certificates only. The debug build may also reach a test server on the
     Mac running the emulator (10.0.2.2) for the updater test. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors><certificates src="system" /></trust-anchors>
    </base-config>
</network-security-config>
